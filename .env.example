# -----------------------------------------------------------------------------
# Configuration Template - Online Book Review & Recommendation Platform
# Security Note: Never commit actual production secrets to source control.
# -----------------------------------------------------------------------------

# Application Environment
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Security Keys (Generate via: python -c 'import secrets; print(secrets.token_hex(32))')
SECRET_KEY=change-this-in-production-to-random-hex-string

# Database Connection (SQLite parameterized default for examination)
DATABASE_URL=sqlite:///instance/book_platform.db

# Cookie & Session Hardening
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=3600

# Rate Limiting & Admin Defaults (Seed script uses these if set)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_EMAIL=admin@platform.local
